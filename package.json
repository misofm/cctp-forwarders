{
  "name": "@misofm/cctp-forwarders",
  "version": "0.0.0-mainnet.1",
  "private": true,
  "type": "module",
  "description": "Keyless Avalanche and Polygon PoS forwarders that bridge native USDC to Sui through Circle CCTP",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@mysten/sui": "2.30.0",
    "@types/node": "26.4.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "files": [
    "dist/evm-forwarder.js",
    "dist/evm-forwarder.d.ts",
    "dist/cctp-v2.js",
    "dist/cctp-v2.d.ts",
    "dist/cctp-v2-sui.js",
    "dist/cctp-v2-sui.d.ts"
  ],
  "exports": {
    "./evm-forwarder": {
      "types": "./dist/evm-forwarder.d.ts",
      "import": "./dist/evm-forwarder.js"
    },
    "./cctp-v2": {
      "types": "./dist/cctp-v2.d.ts",
      "import": "./dist/cctp-v2.js"
    },
    "./cctp-v2-sui": {
      "types": "./dist/cctp-v2-sui.d.ts",
      "import": "./dist/cctp-v2-sui.js"
    }
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.29.0"
  }
}
